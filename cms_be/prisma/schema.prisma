generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum contentStatus{
  DRAFT
  PUBLISHED
}

enum LoginMethod{
  GOOGLE
  MANUAL
}

model Users{
  user_id String @id @default(uuid())
  user_name String @db.VarChar(255)
  user_email String @unique @db.VarChar(255)
  user_password_hashed String
  user_created_at DateTime @default(now())
  user_updated_at DateTime @updatedAt
  reset_password_token_hash String?
  reset_password_expires_at DateTime?
  user_login_method LoginMethod
  ApiKeys ApiKeys[]
  pagesCreated         Pages[]        @relation("PageCreatedBy")
  pagesUpdated         Pages[]        @relation("PageUpdatedBy")
  contentsCreated      Contents[]     @relation("ContentCreatedBy")
  contentsUpdated      Contents[]     @relation("ContentUpdatedBy")
  ContentLogs ContentLogs[]
}

model ApiKeys{
  id String @id @default(uuid())
  user_id String
  key_hash String 
  created_at DateTime @default(now())
  last_used_at DateTime?
  revoked_at DateTime?

  user Users @relation(fields: [user_id], references: [user_id])
}

model Pages{
  page_id String @id @default(uuid())
  page_name String 
  page_description String
  page_meta_title String
  page_meta_desc String
  page_slug String
  page_created_at DateTime @default(now())
  page_updated_at DateTime @updatedAt
  page_created_by String
  page_updated_by String
  content Contents?
  ContentLogs ContentLogs[]
  createdByUser Users @relation("PageCreatedBy", fields: [page_created_by], references: [user_id])
  updatedByUser Users @relation("PageUpdatedBy", fields: [page_updated_by], references: [user_id])
}

model Contents{
  content_id String @id @default(uuid())
  page_id String @unique
  content Json @db.JsonB
  content_status contentStatus
  content_created_at DateTime @default(now())
  content_updated_at DateTime @updatedAt
  content_created_by String
  content_updated_by String

  page Pages @relation(fields: [page_id], references: [page_id])
  createdByUser Users @relation("ContentCreatedBy", fields: [content_created_by], references: [user_id])
  updatedByUser Users @relation("ContentUpdatedBy", fields: [content_updated_by], references: [user_id])
}

model ContentLogs{
  content_log_id String @id @default(uuid())
  page_id String
  content_before Json @db.JsonB 
  content_after Json @db.JsonB
  log_created_at DateTime @default(now())
  log_created_by String

  user Users @relation(fields: [log_created_by], references: [user_id])
  page Pages @relation(fields: [page_id], references: [page_id])
}