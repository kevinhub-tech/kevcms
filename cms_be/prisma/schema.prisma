generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model demo {
  id        Int     @id @default(autoincrement())
  user_name String  @db.Char(255)
  message   String?
}

enum LoginMethod{
  GOOGLE
  MANUAL
}
model Users{
  user_id String @id @default(uuid())
  user_name String @db.VarChar(255)
  user_email String @unique @db.VarChar(255)
  user_password_hashed String
  user_created_at DateTime @default(now())
  user_updated_at DateTime @updatedAt
  reset_password_token_hash String?
  reset_password_expires_at DateTime?
  user_login_method LoginMethod
  ApiKeys ApiKeys[]
}

model ApiKeys{
  id String @id @default(uuid())
  user_id String
  key_hash String 
  created_at DateTime @default(now())
  last_used_at DateTime?
  revoked_at DateTime?

  user Users @relation(fields: [user_id], references: [user_id])
}